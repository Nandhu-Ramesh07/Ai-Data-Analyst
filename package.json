{
  "name": "ai-data-analyst",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "setup": "npm install && uv sync --project apps/api",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "uv run --project apps/api uvicorn app.main:app --app-dir apps/api --reload --reload-dir apps/api/app --port 8000",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
